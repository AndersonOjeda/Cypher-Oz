DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DATABASE_URL=postgresql://tti:replace-with-local-secret@127.0.0.1:54329/tti
FRONTEND_URL=http://localhost:3000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@tti.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Image storage: configure a private S3-compatible bucket (no public write access).
CATALOG_S3_ENDPOINT=
CATALOG_S3_REGION=us-east-1
CATALOG_S3_BUCKET=
CATALOG_S3_ACCESS_KEY=
CATALOG_S3_SECRET_KEY=
CATALOG_IMAGE_MAX_BYTES=5242880
CATALOG_IMAGE_MAX_DIMENSION=4096
CATALOG_IMAGE_MAX_COUNT=8
